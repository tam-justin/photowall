server {
    listen 3000;
    server_tokens off;
    client_max_body_size 6m;

    resolver ${DNS_RESOLVER} valid=30s;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location = /frontend-info {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        return 200 '{"instanceId":"${INSTANCE_ID}","zone":"${ZONE}"}';
    }

    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        error_page 413 = @too_large;
        error_page 502 504 = @backend_down;
    }

    location @too_large {
        default_type application/json;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        return 413 '{"error":"That file is too big (5 MB maximum)"}';
    }

    location @backend_down {
        default_type application/json;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        return 502 '{"error":"backend unavailable"}';
    }
}
